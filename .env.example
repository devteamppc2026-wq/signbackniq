NODE_ENV=development
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
# Optional origin for the original display's sign-in page.
# DISPLAY_ORIGIN=http://127.0.0.1:4200
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=union_display
DB_USER=union_app
DB_PASSWORD=
# disabled for local MySQL, required for TLS, verify_identity for TLS with CA/hostname verification.
DB_SSL_MODE=disabled
# For verify_identity, set a PEM certificate in DB_SSL_CA on Vercel or use a local CA file.
DB_SSL_CA=
DB_SSL_CA_FILE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional local image directory for legacy uploads. Defaults to backend/uploads.
# UPLOAD_DIR=
# Set to 1 only behind exactly one trusted reverse proxy:
TRUST_PROXY=0

# Optional for unattended seeding. Leave both empty for an interactive prompt.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
